PORT=<This server's port e.g., 8080>
CLIENT_ID=<The client id from your Pingram developer account (https://app.pingram.io/signup)>
CLIENT_SECRET=<The client secret from your Pingram developer account>
DB_HOST=<The URL of the MySQL database e.g., 127.0.0.1>
DB_USER=<The username for the MySQL database>
DB_PASSWORD=<The password for the MySQL database>
DB_DATABASE=<The name of the MySQL database e.g., drugbug_db>
VAPID_KEY=<Push notifications Vapid key. You can create one here: https://progressier.com/vapid-key-generator>
FDA_KEY=<You can get a free FDA API key here: https://open.fda.gov/apis/authentication/>
JWT_KEY=<You can generate a key by running a command like 'openssl rand -base64 32'>